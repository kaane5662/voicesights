# Use the official Python image (not slim, for better wheel support)
FROM python:3.12

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY . .

EXPOSE 8000

# By default, start the API. 
# To run Celery, override the CMD in your runtime environment, e.g.:
# docker run ... celery -A app.celery worker --loglevel=info
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]

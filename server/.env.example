# ==============================================================================
# VoiceSight Provider Integrations & Event Streaming Environment Variables
# ==============================================================================

# General
SERVER_DOMAIN=http://localhost:8000
CLIENT_DOMAIN=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here
OPENAI_API_KEY=your_openai_api_key_here
MONGO_DB_URI=mongodb://localhost:27017/voicesight

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=voicesight-transcription-group
KAFKA_MEETING_TOPIC=voice-meeting-recordings
KAFKA_TRANSCRIPT_TOPIC=voice-transcript-processing
KAFKA_RESULTS_TOPIC=voice-transcript-results

# ------------------------------------------------------------------------------
# 1. Zoom Developer Marketplace (OAuth & Webhooks)
# ------------------------------------------------------------------------------
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_REDIRECT_URI=http://localhost:8000/providers/zoom/oauth/callback
ZOOM_WEBHOOK_SECRET_TOKEN=your_zoom_webhook_secret_token

# ------------------------------------------------------------------------------
# 2. Google Meet / Google Cloud Console (OAuth & Webhooks)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_MEET_REDIRECT_URI=http://localhost:8000/providers/google-meet/oauth/callback
GOOGLE_WEBHOOK_SECRET=your_google_webhook_secret

# ------------------------------------------------------------------------------
# 3. Microsoft Teams / Microsoft Entra ID (Azure Graph & Webhooks)
# ------------------------------------------------------------------------------
MS_TEAMS_CLIENT_ID=your_azure_application_client_id
MS_TEAMS_CLIENT_SECRET=your_azure_client_secret_value
MS_TEAMS_TENANT_ID=common
MS_TEAMS_REDIRECT_URI=http://localhost:8000/providers/teams/oauth/callback
MS_TEAMS_CLIENT_STATE=your_custom_secret_client_state_string

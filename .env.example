###############################################################################
#                Environment Variables Example Documentation (.env)            #
#                                                                             #
# Copy this file to `.env` and fill in the necessary values for your setup.   #
# Any variable with a secret key or credentials should be kept secure!        #
#                                                                             #
# If unsure, ask the team or check documentation for specific values.         #
###############################################################################

# --- Astra DB configuration ---
ASTRA_DB_API_ENDPOINT=           # URL for Astra DB API endpoint
ASTRA_DB_APPLICATION_TOKEN=      # Astra DB application authorization token

# --- Pinecone configuration ---
PINECONE_API_KEY=                # Pinecone API key

# --- OpenAI/Anthropic API keys (Required for AI features) ---
OPENAI_API_KEY=                  # OpenAI API key (for GPT integration)
ANTHROPIC_API_KEY=               # Anthropic API key (e.g., for Claude integration)

# --- JWT / Secret Keys ---
JWT_SECRET=                      # Secret used to sign JWT tokens
SERVER_SECRET=                   # Additional server secret (used internally)

# --- MongoDB configuration ---
MONGO_DB_URI=                    # MongoDB connection URI

# --- Google OAuth ---
GOOGLE_CLIENT_ID=                # Google OAuth client ID
GOOGLE_CLIENT_SECRET=            # Google OAuth client secret
GOOGLE_REDIRECT_URI=             # Google OAuth backend redirect URI
GOOGLE_AUTH_REDIRECT_URI=        # Google OAuth frontend redirect URI

# --- Stripe payment configuration ---
STRIPE_API_KEY=                  # Stripe API key
STRIPE_SECRET_KEY=               # Stripe Secret Key (Server Side)
STRIPE_ENDPOINT_SECRET=          # Stripe webhook endpoint secret
STRIPE_WEBHOOK_SECRET=           # Stripe webhook secret

# --- Trello Integration ---
TRELLO_API_KEY=                  # Trello API key

# --- Linear Integration ---
LINEAR_CLIENT_ID=                # Linear OAuth client ID
LINEAR_CLIENT_SECRET=            # Linear OAuth client secret
LINEAR_API_KEY=                  # Linear API key
LINEAR_REDIRECT_URI=             # Linear OAuth callback URL

# --- Slack Integration ---
SLACK_CLIENT_ID=                 # Slack App client ID
SLACK_CLIENT_SECRET=             # Slack App client secret
SLACK_REDIRECT_URI=              # Slack App redirect/callback URI

# --- Neo4j Database ---
NEO4J_URI=                       # Neo4j connection string
NEO4J_USERNAME=                  # Neo4j username
NEO4J_PASSWORD=                  # Neo4j password
NEO4J_DATABASE=                  # Neo4j database name

# --- DataStax/Astra (Optional) ---
AURA_INSTANCEID=                 # Astra instance ID
AURA_INSTANCENAME=               # Astra instance name

# --- RapidAPI Integration ---
RAPID_API_KEY=                   # RapidAPI key

# --- Domain and Environment Settings ---
CLIENT_DOMAIN=                   # Client web app domain (e.g., http://localhost:3000)
SERVER_DOMAIN=                   # Server API domain (e.g., http://localhost:5000)
NEXT_PUBLIC_SERVER_DOMAIN=       # Exposed server domain for client (Frontend)
PRODUCTION=false                 # Set to `true` in production environment
ENV=dev                          # dev, test, staging, or production

###############################################################################
#      Save this file as `.env` after filling in your actual configuration.    #
###############################################################################